# Copy this file to .env (in this deploy/ directory) before `docker compose up`.
# Docker Compose reads it automatically.

# Session-signing secret (>= 32 chars). Generate one:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# First admin login, seeded on startup.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# The URL users open in the browser (scheme + host + port). Auth cookies and
# CSRF checks are validated against this, so it must match reality — e.g.
# http://192.168.1.50:8080 if members reach the server by IP.
PYRA_ORIGIN=http://localhost:8080
