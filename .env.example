PORT=3001
WEB_ORIGIN=http://localhost:5173
# Owner role: migrations, harden, seed, tests.
DATABASE_URL=postgresql://pyra:pyra@localhost:5432/pyra
# Runtime role. Row-level security policies are FORCEd, so leaving this unset
# and running everything as the owner is still safe for a single department —
# it just gives up the second layer. See adr/0003-tenancy-rls.md.
# APP_DATABASE_URL=postgresql://pyra_app:change-me@localhost:5432/pyra
# Set this and run `pnpm --filter @pyra/db harden` to create the pyra_app role.
# It is embedded in APP_DATABASE_URL, so keep it URL-safe.
# PYRA_APP_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pyra
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001
# Optional: override the dev-only seed credentials (required in production)
# SEED_ADMIN_NAME=Admin
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=

# Integration tests read .env.test first when it exists. Point DATABASE_URL
# there at a dedicated database whose name ends in _test; the suite truncates
# every table between cases.
